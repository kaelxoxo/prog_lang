# During local Expo development, "auto" follows the current Metro host when
# the computer changes Wi-Fi. Use an explicit HTTPS URL for a deployed API.
EXPO_PUBLIC_API_URL=auto

# Copy the server variables to .env.server.local. Never expose them to Expo.
SERVER_HOST=0.0.0.0
SERVER_PORT=4000
CORS_ORIGIN=*
POSTGRES_ADMIN_URL=postgresql://postgres:replace-me@127.0.0.1:5432/postgres
DATABASE_NAME=alaga_dev
DATABASE_ROLE=alaga_api
DATABASE_ROLE_PASSWORD=replace-me
DATABASE_URL=postgresql://alaga_api:replace-me@127.0.0.1:5432/alaga_dev

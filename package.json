{
  "name": "alaga",
  "version": "1.0.0",
  "main": "index.ts",
  "dependencies": {
    "@react-native-community/datetimepicker": "9.1.0",
    "@tanstack/react-query": "^5.102.3",
    "expo": "~57.0.16",
    "expo-constants": "~57.0.14",
    "expo-notifications": "~57.0.14",
    "expo-secure-store": "~57.0.1",
    "expo-status-bar": "~57.0.1",
    "pg": "^8.23.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.2",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-web": "^0.21.2"
  },
  "devDependencies": {
    "@types/node": "^26.3.0",
    "@types/pg": "^8.23.1",
    "@types/react": "~19.2.2",
    "tsx": "^4.23.12",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "server": "node --env-file=.env.server.local --import tsx server/src/index.ts",
    "db:setup": "node --env-file=.env.server.local --import tsx server/src/setupDatabase.ts",
    "db:reset:synthetic": "node --env-file=.env.server.local --import tsx server/src/resetSyntheticDatabase.ts",
    "test:server": "node --env-file=.env.server.local --import tsx --test server/tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "verify": "npm run typecheck && npm run test:server && npx expo-doctor",
    "export:android": "expo export --platform android --clear && node scripts/checkNotificationBundle.mjs"
  },
  "private": true
}
